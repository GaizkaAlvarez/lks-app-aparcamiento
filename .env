# AI Chatbot configuration
# Copy the relevant keys to local.properties for the Android app.
# The Python backend (backend/) also reads from backend/.env if used.

# Which AI provider to use: "gemini" or "deepseek"
AI_PROVIDER=deepseek

# Gemini (Google AI)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# DeepSeek
DEEPSEEK_API_KEY=sk-8385d541b592455789a57621ea269447
DEEPSEEK_MODEL=deepseek-v4-flash

# Firebase (only needed for Python backend — not required for Android)
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
